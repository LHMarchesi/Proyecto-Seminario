MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1380687083}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e50db748cc830dc41a3a38f6d4298c63, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  playerContext: {fileID: 0}
  runInventory: {fileID: 1380687084}
  availableAbilities:
  - abilityId: 
    abilityName: Draugblot
    abilityDescription: "El primer enemigo golpeado durante cada lanzamiento de Mjolnir
      genera una explosi\xF3n AoE."
    abilityPrefab: {fileID: 2603085137963816570, guid: e9fb5d6026466924488fb76996ed693f, type: 3}
    icon: {fileID: 21300000, guid: 63b8069a2acbd8643bccf429e6d16e08, type: 3}
    maxLevel: 5
    levelDescriptions:
    - El primer enemigo golpeado durante cada lanzamiento de Mjolnir genera una explosion
      AoE.
    - +20% de radio de explosion.
    - "+20% de da\xF1o de explosion."
    - Aumenta la fuerza/knockback de la explosion.
    - permite una segunda explosion durante el Recall.
    dropChance: 1
  - abilityId: 
    abilityName: Venoumunus
    abilityDescription: Attack1 y Attack2 aplican 1 stack de Poison.
    abilityPrefab: {fileID: 2603085137963816570, guid: 8f6464360a3c7fe48834af4b98c518f9, type: 3}
    icon: {fileID: 21300000, guid: dae9ef3890cd0d74a8112867b38924b9, type: 3}
    maxLevel: 5
    levelDescriptions:
    - Attack1 y Attack2 aplican 1 stack de Poison.
    - "m\xE1ximo de 2 stacks de Poison."
    - Attack2 aplica 2 stacks directamente.
    - "m\xE1ximo de 4 stacks."
    - cuando un enemigo envenenado muere, propaga Poison a enemigos cercanos.
    dropChance: 1
  - abilityId: 
    abilityName: Thunder Strike
    abilityDescription: Al impactar un Charged Attack, cae un Lightning Strike sobre
      un enemigo cercano
    abilityPrefab: {fileID: 2603085137963816570, guid: e7368812e4d3f8d4babf64b6793a6fae, type: 3}
    icon: {fileID: 21300000, guid: 81aca82948e3a004f93b17c55916a336, type: 3}
    maxLevel: 5
    levelDescriptions:
    - Al impactar un Charged Attack, cae un Lightning Strike sobre un enemigo cercano
    - "+20% de da\xF1o adicional al Charged Attack."
    - +1 objetivo para Lightning Strike.
    - "El Charged Attack aplica 30% m\xE1s knockback a todos los enemigos golpeados."
    - "El primer enemigo alcanzado genera una descarga el\xE9ctrica en \xE1rea, da\xF1ando
      a los enemigos cercanos."
    dropChance: 1
  - abilityId: 
    abilityName: MuspelCombo
    abilityDescription: Los ataques melee basicos aplican Burn al enemigo.
    abilityPrefab: {fileID: 2603085137963816570, guid: 9c251959911d0c24eac1eab75f6fc66f, type: 3}
    icon: {fileID: 21300000, guid: 8083e91bcccb9fa41b6d2d6f637aeb14, type: 3}
    maxLevel: 5
    levelDescriptions:
    - "Los ataques melee basicos aplican Burn al enemigo. \t"
    - Burn puede acumularse hasta 2 stacks.
    - El segundo ataque del combo aplica 2 stacks de Burn de una vez.
    - El maximo de Burn aumenta a 4 stacks.
    - "Los enemigos que mueren quemandose explotan, causando da\xF1o alrededor seg\xFAn
      sus stacks de Burn."
    dropChance: 1
  - abilityId: 
    abilityName: Helverg
    abilityDescription: 
    abilityPrefab: {fileID: 2603085137963816570, guid: d1c13818a37ecd1429d899ca809029ff, type: 3}
    icon: {fileID: 21300000, guid: 8fcc2555bffe6524f9af1928a174987c, type: 3}
    maxLevel: 5
    levelDescriptions:
    - Despues de impactar un enemigo, Mjolnir salta hacia 1 enemigo cercano.
    - Mjolnir puede encadenarse hacia 2 enemigos adicionales.
    - "Cada impacto encadenado genera una descarga electrica en \xE1rea."
    - "Mjolnir puede encadenarse hacia 3 enemigos y aumenta en 25% el rango de b\xFAsqueda."
    - "Mjolnir puede encadenarse hacia 3 enemigos y aumenta en 25% el rango de b\xFAsqueda."
    - "Los enemigos alcanzados por los saltos de Mjolnir tambi\xE9n reciben Electricity."
    dropChance: 1
  - abilityId: 
    abilityName: ValkyriesDescent
    abilityDescription: "Falling Hammer genera una onda de choque al impactar contra
      el suelo, da\xF1ando enemigos cercanos."
    abilityPrefab: {fileID: 2603085137963816570, guid: dd2595d3721aa4649a5fb423a1361acb, type: 3}
    icon: {fileID: 21300000, guid: ef83680a5271461499f51027c40fe8cc, type: 3}
    maxLevel: 5
    levelDescriptions:
    - "Falling Hammer genera una onda de choque al impactar contra el suelo, da\xF1ando
      enemigos cercanos."
    - La onda de choque aumenta su radio en 25%
    - "La onda de choque causa 25% m\xE1s da\xF1o."
    - La onda de choque tambien lanza a los enemigos hacia arriba.
    - "El impacto invoca un rayo adicional que causa da\xF1o el\xE9ctrico y aplica
      Electricity a los enemigos alcanzados."
    dropChance: 100
  - abilityId: 
    abilityName: StormRecall
    abilityDescription: 
    abilityPrefab: {fileID: 2603085137963816570, guid: dc611b868ba9cfc4aaf8e2f00dadb596, type: 3}
    icon: {fileID: 21300000, guid: 710d1d30d7074ee40a6392b5ea4ed617, type: 3}
    maxLevel: 5
    levelDescriptions:
    - "El regreso de Mjolnir causa 30% m\xE1s da\xF1o y aplica Electricity a los
      enemigos que atraviesa."
    - "Mjolnir regresa 20% m\xE1s r\xE1pido."
    - "Electricity durante el recall aumenta en 50% su stun y da\xF1o por segundo"
    - "Cada enemigo golpeado durante el regreso aumenta en 10% el da\xF1o del siguiente
      impacto, acumul\xE1ndose hasta +50%."
    - "Al atrapar Mjolnir despu\xE9s de un recall, Thor libera una descarga el\xE9ctrica
      alrededor suyo, da\xF1ando y electrificando enemigos cercanos."
    dropChance: 1
  - abilityId: 
    abilityName: JotunBreaker
    abilityDescription: "El Charged Attack obtiene 40% m\xE1s fuerza de knockback,
      lanzando enemigos con mucha m\xE1s violencia."
    abilityPrefab: {fileID: 2603085137963816570, guid: a6c74ad682eb4b545be436ca5a7f708b, type: 3}
    icon: {fileID: 21300000, guid: c1ea25fe28d930644a77e9704899ce07, type: 3}
    maxLevel: 5
    levelDescriptions:
    - "El Charged Attack obtiene 40% m\xE1s fuerza de knockback, lanzando enemigos
      con mucha m\xE1s violencia."
    - "El Charged Attack causa 20% m\xE1s da\xF1o."
    - "Los enemigos lanzados que chocan generan un impacto en \xE1rea, da\xF1ando
      a otros enemigos cercanos."
    - "Los enemigos lanzados que chocan generan un impacto en \xE1rea, da\xF1ando
      a otros enemigos cercanos."
    dropChance: 1
  experienceTable: {fileID: 11400000, guid: 17fb45079f94fb445a55e313b1acdc0c, type: 2}
